# MCP Server Builder Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# GitHub Configuration
# ============================================================================
# Your GitHub personal access token for creating repositories
# Get one at: https://github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=your_github_token_here

# ============================================================================
# NPM Configuration
# ============================================================================
# Your NPM authentication token for publishing packages
# Get one at: https://www.npmjs.com/settings/tokens
# Create an "Automation" token for best security
NPM_TOKEN=your_npm_token_here

# ============================================================================
# Optional Configuration
# ============================================================================
# Your GitHub username (defaults to token owner if not specified)
# GITHUB_USERNAME=your_username

# Your NPM username (defaults to token owner if not specified)
# NPM_USERNAME=your_username

# Default author name for package.json
# AUTHOR_NAME=Your Name

# Default author email for package.json
# AUTHOR_EMAIL=your.email@example.com
